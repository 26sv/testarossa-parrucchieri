---
const { title = 'Testa Rossa Parrucchieri | Maranello', description = 'Salone di parrucchieri a Maranello per donna e uomo. Taglio, colore, piega e barba. Via Teano 8, tel. 0536 940227.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <header class="top">
      <a class="logo" href={`${base}/`}>Testa Rossa</a>
      <nav>
        <a href={`${base}/#servizi`}>Servizi</a>
        <a href={`${base}/#orari`}>Orari</a>
        <a href={`${base}/#contatti`}>Contatti</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <p>Testa Rossa Parrucchieri &middot; Via Teano 8, 41053 Maranello (MO) &middot; <a href="tel:0536940227">0536 940227</a></p>
      <p><a href={`${base}/privacy`}>Informativa privacy</a></p>
    </footer>
  </body>
</html>

<style is:global>
  :root { --bg:#111; --fg:#f5f1ec; --red:#d1241f; --muted:#b9b2aa; --line:#2b2b2b; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin:0; background:var(--bg); color:var(--fg); font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; line-height:1.55; }
  a { color: inherit; }
  .top { display:flex; justify-content:space-between; align-items:center; padding:20px 6vw; position:sticky; top:0; background:rgba(17,17,17,.92); backdrop-filter: blur(6px); border-bottom:1px solid var(--line); z-index:5; }
  .logo { font-weight:700; letter-spacing:.18em; text-transform:uppercase; color:var(--red); text-decoration:none; }
  .top nav a { margin-left:20px; text-decoration:none; font-size:14px; }
  .top nav a:hover { color:var(--red); }
  section { padding: 64px 6vw; max-width: 1100px; margin: 0 auto; }
  h1,h2 { font-family: Georgia, 'Times New Roman', serif; font-weight:400; line-height:1.05; }
  h1 { font-size: clamp(42px, 9vw, 88px); margin:0 0 20px; }
  h1 em { color: var(--red); font-style: normal; }
  h2 { font-size: clamp(30px, 5vw, 44px); margin:0 0 24px; }
  .lead { font-size:20px; max-width:560px; color:var(--muted); }
  .btn { display:inline-block; background:var(--red); color:#fff; padding:14px 28px; border-radius:2px; text-decoration:none; font-weight:600; margin:20px 12px 0 0; }
  .btn.ghost { background:transparent; border:1px solid var(--red); }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:20px; }
  .card { border:1px solid var(--line); border-top:3px solid var(--red); padding:24px; }
  .card h3 { margin:0 0 6px; color:var(--red); }
  .card p { margin:0; color:var(--muted); }
  table { border-collapse:collapse; width:100%; max-width:480px; }
  td { padding:10px 0; border-bottom:1px solid var(--line); }
  td:last-child { text-align:right; color:var(--muted); }
  .stars { color:var(--red); font-size:22px; letter-spacing:2px; }
  .map { width:100%; height:320px; border:0; filter: grayscale(1) invert(.92) contrast(.9); margin-top:20px; }
  footer { padding:32px 6vw; border-top:1px solid var(--line); color:var(--muted); font-size:14px; }
  footer p { margin:4px 0; }
  .doc { max-width:760px; }
  .doc h2 { font-size:26px; margin-top:36px; }
</style>
